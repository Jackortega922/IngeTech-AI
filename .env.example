APP_NAME="IngeTech AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────
# Con Docker Compose, DB_HOST=db. En dev nativo (php artisan serve), DB_HOST=127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ingetech
DB_USERNAME=ingetech
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@ingetech.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Motor de recomendación (ver docs/adr/0003) ──
# http -> Laravel llama por HTTP al servicio ml-engine (desarrollo con Docker)
# cli  -> Laravel ejecuta python cli_entry.py como subproceso (producción)
RECOMMENDER_MODE=http
RECOMMENDER_URL=http://ml-engine:5001
RECOMMENDER_CLI="python ml-engine/cli_entry.py"

VITE_APP_NAME="${APP_NAME}"
