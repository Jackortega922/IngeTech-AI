APP_NAME="IngeTech AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de datos ─────────────────────────────
# Con Docker Compose, DB_HOST=db. En dev nativo (php artisan serve), DB_HOST=127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ingetech
DB_USERNAME=ingetech
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Correos (confirmación de compra, estado del pedido, Libro de Reclamaciones, verificación).
# "log" = no se envían, quedan escritos en storage/logs/laravel.log (desarrollo).
# Para enviarlos de verdad con Gmail (gratis, ~500 correos al día):
#   1. Activa la verificación en dos pasos en tu cuenta de Google.
#   2. Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   3. Usa: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
#      MAIL_USERNAME=tucorreo@gmail.com, MAIL_PASSWORD=<la contraseña de aplicación>,
#      MAIL_FROM_ADDRESS=tucorreo@gmail.com
# Las contraseñas van solo aquí, nunca en el código ni en chats.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@ingetech.test"
MAIL_FROM_NAME="${APP_NAME}"

# ── Motor de recomendación (ver docs/adr/0003) ──
# http -> Laravel llama por HTTP al servicio ml-engine (desarrollo con Docker)
# cli  -> Laravel ejecuta python cli_entry.py como subproceso (producción)
# Nota: Laravel corre nativo hasta que exista el contenedor `app` (tarea A2), así que
# el hostname de Docker `ml-engine` no resuelve desde el host — usa localhost.
RECOMMENDER_MODE=http
RECOMMENDER_URL=http://localhost:5001
RECOMMENDER_CLI="python ml-engine/cli_entry.py"

VITE_APP_NAME="${APP_NAME}"

# Contacto de la tienda (portada, footer y botón de WhatsApp). Vacío = no se muestra.
# TIENDA_WHATSAPP: con código de país, sin "+" ni espacios (ej. 51987654321).
TIENDA_WHATSAPP=
TIENDA_EMAIL=
TIENDA_TELEFONO=
TIENDA_DIRECCION=
TIENDA_HORARIO=
TIENDA_FACEBOOK_URL=
TIENDA_INSTAGRAM_URL=
TIENDA_TIKTOK_URL=
TIENDA_YOUTUBE_URL=
# Emisor de la boleta de venta (simulada). Vacío = la boleta muestra "por configurar".
TIENDA_RAZON_SOCIAL=
TIENDA_RUC=

# Chat con LLM (Gemini, gratis en https://aistudio.google.com — sin tarjeta). Vacío = el chat
# responde con el asistente por palabras clave. La clave va solo aquí, nunca en el código ni en chats.
GEMINI_API_KEY=
# Uno o varios modelos separados por coma: si uno está saturado o retirado, se prueba el siguiente.
GEMINI_MODEL=gemini-flash-latest,gemini-3.8-flash,gemini-3.5-flash,gemini-flash-lite-latest
