# Copia este archivo a .env y ajusta si hace falta.
# .env NUNCA se sube a git.

APP_NAME="IngeTech AI"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── Base de datos (coincide con docker-compose.yml) ──
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ingetech
DB_USERNAME=ingetech
DB_PASSWORD=secret

# ── Motor de recomendación ──
# http  -> Laravel llama por HTTP al servicio ml-engine (desarrollo local)
# cli   -> Laravel ejecuta python cli_entry.py como subproceso (producción)
RECOMMENDER_MODE=http
RECOMMENDER_URL=http://ml-engine:5001
RECOMMENDER_CLI="python ml-engine/cli_entry.py"
