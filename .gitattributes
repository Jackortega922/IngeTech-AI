# Normaliza saltos de línea: en el repo siempre LF, sin importar el SO.
* text=auto eol=lf

*.php    text eol=lf diff=php
*.blade.php text eol=lf diff=html
*.js     text eol=lf
*.jsx    text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf diff=css
*.html   text eol=lf diff=html
*.py     text eol=lf
*.json   text eol=lf
*.md     text eol=lf diff=markdown
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

*.png    binary
*.jpg    binary
*.ico    binary
*.ttf    binary
*.pbix   binary

# No incluir en los archivos de distribución (composer archive)
CHANGELOG.md    export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.github         export-ignore
tests           export-ignore
